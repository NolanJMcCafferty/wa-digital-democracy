terraform {
  required_version = ">= 1.6.0"

  required_providers {
    railway = {
      source  = "terraform-community-providers/railway"
      version = "~> 0.6.2"
    }
  }
}

provider "railway" {}

variable "project_name" {
  type    = string
  default = "wa-digital-democracy"
}

variable "workspace_id" {
  type    = string
  default = null
}

variable "github_repo" {
  description = "GitHub repository in owner/name form, for example nolan-mccafferty/wa-digital-democracy."
  type        = string
}

variable "github_branch" {
  type    = string
  default = "main"
}

variable "daily_cron" {
  type    = string
  default = "30 3 * * *"
}

variable "daily_biennium" {
  type    = string
  default = "2025-26"
}

variable "postgis_password" {
  type      = string
  sensitive = true
}

variable "r2_endpoint_url" {
  type = string
}

variable "r2_bucket_raw" {
  type = string
}

variable "r2_access_key_id" {
  type      = string
  sensitive = true
}

variable "r2_secret_access_key" {
  type      = string
  sensitive = true
}

variable "invintus_embedder_key" {
  type      = string
  sensitive = true
}

variable "socrata_app_token" {
  type      = string
  sensitive = true
  default   = ""
}

variable "source_user_agent" {
  type    = string
  default = "wa-dd/0.0.1 (https://github.com/nolan-mccafferty/wa-digital-democracy; contact: nolan-mccafferty)"
}

resource "railway_project" "wadd" {
  name         = var.project_name
  description  = "Washington Digital Democracy hosted demo"
  private      = true
  workspace_id = var.workspace_id

  default_environment = {
    name = "production"
  }
}

locals {
  environment_id = railway_project.wadd.default_environment.id
}

# This is the IaC-friendly PostGIS path. It deploys the PostGIS image as a
# Railway service with a persistent volume. If you prefer Railway's marketplace
# PostGIS template, create the database service manually and replace the
# DATABASE_URL variables below with the template-provided reference variable.
resource "railway_service" "postgis" {
  name         = "postgis"
  project_id   = railway_project.wadd.id
  source_image = "postgis/postgis:16-3.5-alpine"

  volume = {
    name       = "postgis-data"
    mount_path = "/var/lib/postgresql/data"
    size       = 10240
  }
}

resource "railway_variable" "postgis_user" {
  name           = "POSTGRES_USER"
  value          = "wadd"
  project_id     = railway_project.wadd.id
  environment_id = local.environment_id
  service_id     = railway_service.postgis.id
}

resource "railway_variable" "postgis_db" {
  name           = "POSTGRES_DB"
  value          = "wa_dd"
  project_id     = railway_project.wadd.id
  environment_id = local.environment_id
  service_id     = railway_service.postgis.id
}

resource "railway_variable" "postgis_password" {
  name           = "POSTGRES_PASSWORD"
  value          = var.postgis_password
  project_id     = railway_project.wadd.id
  environment_id = local.environment_id
  service_id     = railway_service.postgis.id
}

resource "railway_service" "api" {
  name               = "api"
  project_id         = railway_project.wadd.id
  source_repo        = var.github_repo
  source_repo_branch = var.github_branch
}

resource "railway_service" "web" {
  name               = "web"
  project_id         = railway_project.wadd.id
  source_repo        = var.github_repo
  source_repo_branch = var.github_branch
  root_directory     = "apps/web"
  config_path        = "/apps/web/railway.json"
}

resource "railway_service" "migrate" {
  name               = "migrate"
  project_id         = railway_project.wadd.id
  source_repo        = var.github_repo
  source_repo_branch = var.github_branch
  config_path        = "/infra/railway/config/migrate.railway.json"
}

resource "railway_service" "daily" {
  name               = "daily"
  project_id         = railway_project.wadd.id
  source_repo        = var.github_repo
  source_repo_branch = var.github_branch
  config_path        = "/infra/railway/config/daily.railway.json"
  cron_schedule      = var.daily_cron
}

locals {
  database_url = "postgres://$${{postgis.POSTGRES_USER}}:$${{postgis.POSTGRES_PASSWORD}}@$${{postgis.RAILWAY_PRIVATE_DOMAIN}}:5432/$${{postgis.POSTGRES_DB}}?sslmode=disable"

  api_vars = {
    APP_ENV           = "production"
    LOG_LEVEL         = "info"
    DATABASE_URL      = local.database_url
    SOURCE_USER_AGENT = var.source_user_agent
  }

  migrate_vars = {
    DATABASE_URL = local.database_url
  }

  daily_vars = {
    APP_ENV               = "production"
    LOG_LEVEL             = "info"
    DATABASE_URL          = local.database_url
    OBJECT_STORE          = "s3"
    S3_ENDPOINT_URL       = var.r2_endpoint_url
    S3_REGION             = "auto"
    S3_BUCKET_RAW         = var.r2_bucket_raw
    S3_ACCESS_KEY_ID      = var.r2_access_key_id
    S3_SECRET_ACCESS_KEY  = var.r2_secret_access_key
    S3_FORCE_PATH_STYLE   = "false"
    S3_PREFIX             = "raw"
    INVINTUS_EMBEDDER_KEY = var.invintus_embedder_key
    SOCRATA_APP_TOKEN     = var.socrata_app_token
    SOURCE_USER_AGENT     = var.source_user_agent
    BIENNIUM              = var.daily_biennium
  }
}

resource "railway_variable" "api" {
  for_each       = local.api_vars
  name           = each.key
  value          = each.value
  project_id     = railway_project.wadd.id
  environment_id = local.environment_id
  service_id     = railway_service.api.id
}

resource "railway_variable" "migrate" {
  for_each       = local.migrate_vars
  name           = each.key
  value          = each.value
  project_id     = railway_project.wadd.id
  environment_id = local.environment_id
  service_id     = railway_service.migrate.id
}

resource "railway_variable" "daily" {
  for_each       = local.daily_vars
  name           = each.key
  value          = each.value
  project_id     = railway_project.wadd.id
  environment_id = local.environment_id
  service_id     = railway_service.daily.id
}

resource "railway_variable" "web_api_url" {
  for_each = {
    WADD_API_URL         = "https://replace-after-api-domain"
    API_BASE_URL         = "https://replace-after-api-domain"
    NEXT_PUBLIC_API_URL  = "https://replace-after-api-domain"
    NEXT_PUBLIC_SITE_URL = "https://replace-after-web-domain"
  }
  name           = each.key
  value          = each.value
  project_id     = railway_project.wadd.id
  environment_id = local.environment_id
  service_id     = railway_service.web.id
}
