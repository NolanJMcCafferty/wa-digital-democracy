# Shared Railway variables. Put secrets in Railway, not in git.

APP_ENV=production
LOG_LEVEL=info

# Provided by the Railway Postgres/PostGIS service or copied from its variables.
DATABASE_URL=postgres://...

# Public URLs after Railway assigns/customizes domains.
PUBLIC_BASE_URL=https://wa-digital-democracy.example.org
NEXT_PUBLIC_SITE_URL=https://wa-digital-democracy.example.org

# API URL used by the Next.js server runtime and server-side /api/v1 proxy.
# In Railway, prefer the API service private domain, e.g.:
# WADD_API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080
WADD_API_URL=https://wa-dd-api.example.org
API_BASE_URL=https://wa-dd-api.example.org

# Shared server-only bearer token required by all Go /api/v1 endpoints.
# Set the same value on the API and web services; never expose it as NEXT_PUBLIC_*.
WADD_INTERNAL_API_TOKEN=

# Raw source artifact storage: Cloudflare R2 via S3-compatible API.
OBJECT_STORE=s3
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_RAW=wa-dd-raw-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=raw
S3_PUBLIC_BASE_URL=

# Upstream/API secrets.
INVINTUS_EMBEDDER_KEY=
SOCRATA_APP_TOKEN=
SOURCE_USER_AGENT=wa-dd/0.0.1 (https://github.com/nolan-mccafferty/wa-digital-democracy; contact: nolan-mccafferty)
BIENNIUM=2025-26
