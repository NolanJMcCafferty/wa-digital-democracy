# Non-secret defaults for the local Go API container.
# Secrets (WADD_INTERNAL_API_TOKEN, CLERK_*, etc.) come from the repo-root .env,
# which is layered on top via docker-compose.yml.

WADD_DSN=postgres://wadd:wadd@postgres:5432/wa_dd?sslmode=disable
PORT=8080
APP_ENV=local
LOG_LEVEL=info
WADD_ADMIN_JWT_AUDIENCE=wa-dd-admin
