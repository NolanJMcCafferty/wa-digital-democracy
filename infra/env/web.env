# Non-secret defaults for the local Next.js web container.
# Secrets (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY,
# WADD_INTERNAL_API_TOKEN) come from the repo-root .env, layered on top
# via docker-compose.yml.

WADD_API_URL=http://api:8080
API_BASE_URL=http://api:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
