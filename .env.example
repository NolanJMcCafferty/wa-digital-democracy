# Copy to .env.local for host-run Make targets.
# Copy to .env as well if you use the Docker Compose full stack (`make up`).
# Do not commit .env or .env.local.

# Required for TVW/Invintus caption ingestion (`make ingest-hearings` / `make daily`).
INVINTUS_EMBEDDER_KEY=

# Diarization providers. Set whichever you plan to use with `wa-dd diarize-event`.
DEEPGRAM_API_KEY=
PYANNOTEAI_API_KEY=

# Optional. Socrata/Tyler app token for data.wa.gov/PDC requests.
# Leave blank unless/until data.wa.gov starts returning throttling/rate-limit
# errors during broader PDC backfills. Public read requests currently work
# without a token for the MVP demo.
SOCRATA_APP_TOKEN=

# Local docker-compose Postgres default.
WADD_DSN=postgres://wadd:wadd@localhost:5432/wa_dd?sslmode=disable

# Hosted deployment aliases. DATABASE_URL is accepted anywhere WADD_DSN is used.
# Railway usually provides DATABASE_URL from the Postgres service.
DATABASE_URL=
APP_ENV=local
LOG_LEVEL=info
SOURCE_USER_AGENT=wa-dd/0.0.1 (https://github.com/nolan-mccafferty/wa-digital-democracy; contact: nolan-mccafferty)

# Frontend/API connection. Server Components read WADD_API_URL or API_BASE_URL.
# Browser-originated /api/v1 requests go through the Next.js server proxy so the
# internal API token is never exposed to client-side JavaScript.
WADD_API_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared internal bearer token required by all Go /api/v1 endpoints.
# Set the same server-only value on both the Go API service and Next.js web app.
WADD_INTERNAL_API_TOKEN=dev-change-me

# Clerk admin authentication for /admin UI and /api/v1/admin API routes.
# Configure a Clerk JWT template named "wadd-admin" with audience "wa-dd-admin"
# and claims for email/name plus one role claim: role, admin_role, or wadd_role.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_JWKS_URL=
WADD_ADMIN_JWT_AUDIENCE=wa-dd-admin
