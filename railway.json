{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/railway.json",
      "/Dockerfile",
      "/go.mod",
      "/go.sum",
      "/cmd/wa-dd-api/**",
      "/internal/**",
      "/db/migrations/**"
    ]
  },
  "deploy": {
    "startCommand": "wa-dd-api",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
